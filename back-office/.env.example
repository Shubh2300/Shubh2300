# Back Office — environment variable NAMES only.
# Copy to `.env` on the office machine and fill in real values there.
# NEVER commit `.env`. Secrets live ONLY in `.env` on the office machine
# (decision #3) — never in git, never in code, never in logs.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Full DSN used by the API and worker (compose builds this from the parts above,
# but you can override it here for local non-docker runs).
DATABASE_URL=

# --- Temporal ---------------------------------------------------------------
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_TASK_QUEUE=

# --- EMR bridge (runs on the HOST, not a container) -------------------------
# Containers reach the host-run bridge via host.docker.internal.
BRIDGE_URL=

# --- AI parser --------------------------------------------------------------
# If OPENAI_API_KEY is absent, POST /intents/parse returns a structured error
# (parser_unavailable) — never canned output.
OPENAI_API_KEY=
OPENAI_PARSER_MODEL=

# --- Action registry artifacts (owned by packages/action-registry) ----------
ACTION_REGISTRY_PATH=
ACTION_INTENT_SCHEMA_PATH=

# --- Audit log --------------------------------------------------------------
# Per-install pepper used to hash patient identifiers in the audit chain.
AUDIT_PEPPER=

# --- Web + CORS -------------------------------------------------------------
# Comma-separated list of origins the API allows (the Next.js app's URL).
CORS_ORIGINS=
# Base URL of the API, injected into the Next.js app at build/runtime.
NEXT_PUBLIC_API_URL=
